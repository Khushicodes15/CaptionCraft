# ─── Supabase Configuration ───────────────────────────────────────────
# Client build-time variables (baked into frontend bundle):
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id

# Server runtime variables (used in server functions and SSR):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Speech-to-Text Transcription APIs ─────────────────────────────────
# Groq API for English transcription (Groq Whisper large v3) & LLM catchy-word detection
GROQ_API_KEY=gsk_your-groq-api-key

# Sarvam AI API for Hindi & Hinglish transcription (Saaras v4)
SARVAM_API_KEY=your-sarvam-subscription-key

# ─── Python & Runtime Configuration ───────────────────────────────────
# Path to Python 3 binary with PyTorch and stable-ts installed.
# Default on Linux / Docker: python3
# Default in Docker container: /opt/venv/bin/python3
# Default on local Windows: system python or AppData path
PYTHON_BIN=python3

# ─── Server Port ──────────────────────────────────────────────────────
PORT=3000

